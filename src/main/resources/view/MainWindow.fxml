<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity"
            minHeight="400.0" minWidth="350.0"
            prefHeight="600.0" prefWidth="450.0"
            style="-fx-background-color: #1e1e1e;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="marvin.gui.MainWindow">
    <children>
        <!-- Used Claude to generate code for an input area with placeholder text and a send button with rounded corners -->
        <!-- Input area-->
        <AnchorPane style="-fx-background-color: #2d2d2d; -fx-border-color: #3d3d3d; -fx-border-width: 1 0 0 0;"
                    AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0">
            <children>
                <TextField fx:id="userInput"
                           onAction="#handleUserInput"
                           promptText="Type your message..."
                           style="-fx-background-color: #2d2d2d; -fx-text-fill: #e0e0e0; -fx-prompt-text-fill: #808080; -fx-background-radius: 0; -fx-border-width: 0; -fx-padding: 12 12 12 12; -fx-font-size: 14px;"
                           AnchorPane.bottomAnchor="8.0"
                           AnchorPane.leftAnchor="8.0"
                           AnchorPane.rightAnchor="80.0"
                           AnchorPane.topAnchor="8.0"/>
                <Button fx:id="sendButton"
                        mnemonicParsing="false"
                        onAction="#handleUserInput"
                        text="Send"
                        style="-fx-background-color: #0d7377; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold;"
                        AnchorPane.bottomAnchor="8.0"
                        AnchorPane.rightAnchor="8.0"
                        AnchorPane.topAnchor="8.0">
                    <styleClass>
                        <String fx:value="send-button"/>
                    </styleClass>
                </Button>
            </children>
        </AnchorPane>

        <!-- Chat area -->
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    style="-fx-background: #1e1e1e; -fx-background-color: #1e1e1e; -fx-border-width: 0;"
                    AnchorPane.bottomAnchor="56.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="0.0">
            <content>
                <VBox fx:id="dialogContainer"
                      spacing="8"
                      style="-fx-background-color: #1e1e1e; -fx-padding: 10 10 10 10;"/>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
